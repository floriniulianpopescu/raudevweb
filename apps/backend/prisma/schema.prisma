
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  xp            Int       @default(0)

  sessions Session[]
  accounts Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

/// Practice item that lives on another website.
model Problem {
  id          String      @id @default(cuid())
  title       String
  description String      @default("")
  href        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  challenges  Challenge[]

  @@map("problem")
}

/// Practice item that lives on another website.
model Exercise {
  id          String      @id @default(cuid())
  title       String
  description String      @default("")
  href        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  challenges  Challenge[]

  @@map("exercise")
}

/// Groups several problems and/or exercises under one in-site page.
model Challenge {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  problems    Problem[]
  exercises   Exercise[]

  @@map("challenge")
}

model Quiz {
  id          String         @id @default(cuid())
  title       String
  description String         @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  questions   QuizQuestion[]

  @@map("quiz")
}

/// Always 4 answers with exactly one correct (enforced by the API schema).
model QuizQuestion {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  position     Int
  question     String
  answers      String[]
  correctIndex Int

  @@map("quiz_question")
  @@index([quizId])
}

enum ResourceKind {
  lesson
  extra
}

/// Lessons and extras: title, description and a small bibliography.
model Resource {
  id          String         @id @default(cuid())
  kind        ResourceKind
  title       String
  description String         @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  links       ResourceLink[]

  @@map("resource")
  @@index([kind])
}

model ResourceLink {
  id          String   @id @default(cuid())
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  description String   @default("")
  href        String

  @@map("resource_link")
  @@index([resourceId])
}

// ---------------------------------------------------------------------------
// Site settings
// ---------------------------------------------------------------------------

/// Single row (id = "default") describing the weekly physical session.
model SessionSchedule {
  id            String   @id @default("default")
  /// This week's lesson name (empty → "Physical session")
  title         String   @default("")
  /// 0 = Sunday … 6 = Saturday
  weekday       Int      @default(5)
  startTime     String   @default("11:00")
  endTime       String   @default("14:00")
  location      String   @default("")
  note          String   @default("")
  /// YYYY-MM-DD; null → use the calendar week number
  semesterStart String?
  cancelled     Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@map("session_schedule")
}
