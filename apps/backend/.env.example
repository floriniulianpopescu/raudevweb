# Environment variables for rau backend
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rau_db"
BETTER_AUTH_SECRET="change-this-to-a-secure-random-secret-at-least-32-chars-long"
BETTER_AUTH_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:5173"
PORT=3000

# Email (Resend). Leave RESEND_API_KEY empty to print emails to the console instead.
# Without a verified domain, Resend only delivers from onboarding@resend.dev to your own account's email.
RESEND_API_KEY=""
EMAIL_FROM="RAUDEV <onboarding@resend.dev>"
